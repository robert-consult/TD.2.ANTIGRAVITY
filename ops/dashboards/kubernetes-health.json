{
    "title": "TradeHub — Kubernetes Health",
    "uid": "th-k8s-health",
    "editable": true,
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "refresh": "30s",
    "templating": {
        "list": [
            {
                "name": "namespace",
                "type": "query",
                "query": "label_values(kube_pod_info, namespace)",
                "datasource": "Prometheus",
                "current": {
                    "text": "tradehub",
                    "value": "tradehub"
                }
            }
        ]
    },
    "panels": [
        {
            "title": "Pod Restarts",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[10m])",
                    "legendFormat": "{{pod}}"
                }
            ]
        },
        {
            "title": "OOMKilled Events",
            "type": "stat",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(kube_pod_container_status_terminated_reason{namespace=~\"$namespace\",reason=\"OOMKilled\"})"
                }
            ]
        },
        {
            "title": "Unavailable Replicas",
            "type": "stat",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(kube_deployment_status_replicas_unavailable{namespace=~\"$namespace\"})"
                }
            ]
        },
        {
            "title": "HPA Current vs Desired",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "kube_hpa_status_current_replicas{namespace=~\"$namespace\"}",
                    "legendFormat": "current {{hpa}}"
                },
                {
                    "expr": "kube_hpa_status_desired_replicas{namespace=~\"$namespace\"}",
                    "legendFormat": "desired {{hpa}}"
                }
            ]
        },
        {
            "title": "PVC Usage",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\"} * 100",
                    "legendFormat": "{{persistentvolumeclaim}}"
                }
            ]
        }
    ]
}