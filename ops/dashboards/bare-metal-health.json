{
    "title": "TradeHub — Bare Metal Health",
    "uid": "th-bare-metal",
    "editable": true,
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "refresh": "30s",
    "templating": {
        "list": [
            {
                "name": "instance",
                "type": "query",
                "query": "label_values(node_uname_info, instance)",
                "datasource": "Prometheus"
            }
        ]
    },
    "panels": [
        {
            "title": "CPU Usage %",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "100 - (avg by(instance)(irate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)"
                }
            ]
        },
        {
            "title": "Memory Available",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "node_memory_MemAvailable_bytes{instance=~\"$instance\"}"
                }
            ]
        },
        {
            "title": "Disk I/O Saturation",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "rate(node_disk_io_time_seconds_total{instance=~\"$instance\"}[5m])"
                }
            ]
        },
        {
            "title": "Network TX/RX (bytes/s)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "rate(node_network_transmit_bytes_total{instance=~\"$instance\",device!=\"lo\"}[5m])",
                    "legendFormat": "TX {{device}}"
                },
                {
                    "expr": "rate(node_network_receive_bytes_total{instance=~\"$instance\",device!=\"lo\"}[5m])",
                    "legendFormat": "RX {{device}}"
                }
            ]
        },
        {
            "title": "Filesystem Free %",
            "type": "gauge",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 16
            },
            "targets": [
                {
                    "expr": "(node_filesystem_avail_bytes{instance=~\"$instance\",mountpoint=\"/\"} / node_filesystem_size_bytes{instance=~\"$instance\",mountpoint=\"/\"}) * 100"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "steps": [
                            {
                                "value": 0,
                                "color": "red"
                            },
                            {
                                "value": 20,
                                "color": "orange"
                            },
                            {
                                "value": 50,
                                "color": "green"
                            }
                        ]
                    }
                }
            }
        }
    ]
}