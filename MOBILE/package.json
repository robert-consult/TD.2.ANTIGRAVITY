{
    "name": "tradequip-mobile",
    "version": "1.0.0",
    "description": "TradeQuip Mobile - Capacitor Android + iOS Wrapper",
    "type": "module",
    "scripts": {
        "install:jdk": "bash scripts/install-jdk.sh",
        "sync": "cd .. && npm run build && cd MOBILE && npx cap sync",
        "open:android": "npx cap open android",
        "open:ios": "npx cap open ios",
        "run:android": "bash scripts/with-jdk.sh npx cap run android",
        "run:ios": "bash scripts/run-ios.sh",
        "build:android": "bash scripts/with-jdk.sh ./android/gradlew -p android assembleDebug",
        "build:android:release": "bash scripts/with-jdk.sh ./android/gradlew -p android assembleRelease",
        "tunnel:android": "bash scripts/trycloudflare-tunnel.sh",
        "doctor": "bash scripts/with-jdk.sh npx cap doctor"
    },
    "dependencies": {
        "@capacitor/android": "^8.2.0",
        "@capacitor/app": "^8.0.0",
        "@capacitor/core": "^8.0.1",
        "@capacitor/haptics": "^8.0.1",
        "@capacitor/ios": "^8.2.0",
        "@capacitor/keyboard": "^8.0.1",
        "@capacitor/network": "^8.0.1",
        "@capacitor/push-notifications": "^8.0.2",
        "@capacitor/splash-screen": "^8.0.1",
        "@capacitor/status-bar": "^8.0.1"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.2.0"
    }
}
