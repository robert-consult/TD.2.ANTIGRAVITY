NODE_ENV=development
APP_URL=http://localhost:5000

# REQUIRED (server will exit if missing/too short)
LEGAL_TERMS_HMAC_SECRET=394f85d69052ef527071b896db7922bfcd48a077d2d468592b7fb6eca5149a7f

# Recommended for session hardening (dev-safe value is fine)
SESSION_SECRET=dev-session-secret-change-me

# Optional in dev (warnings only), required in prod
RESEND_API_KEY=
EMAIL_VERIFY_TOKEN_SECRET=
EMAIL_FROM=TradeQuip <noreply@tradequip.com>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Optional quote feed (if blank, repo falls back to simulation paths in places)
FORGE_KEY=8ZWPCvwnNG9yT3g8vJnVBF1tSxbVDsXd

# Optional Valkey (repo already supports VALKEY_URL in server/services/valkey.ts)
VALKEY_URL=redis://localhost:6379/0

# Postgres primary database
DB_DIALECT=postgres
DATABASE_URL=postgresql://tradehub:tradehub_pw@localhost:5432/tradehub

# Quote persistence controls (production defaults)
QUOTE_DB_WRITE_MODE=interval
QUOTE_DB_WRITE_INTERVAL_MS=60000
DAILY_CLOSE_WRITE_INTERVAL_MS=60000

# Account recalculation throttles
ACCOUNT_RECALC_THROTTLE_MS=3000
ACCOUNT_RECALC_BATCH_INTERVAL_MS=1000

# Image build note (local-only). Update when pushing to the online registry.
IMAGE_REGISTRY=registry.equitywaves.com/tradehub/app
IMAGE_TAG=local-20260113-001036
