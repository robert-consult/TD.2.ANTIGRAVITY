# TradeQuip / TradeHub — Environment Template
#
# Copy this file to `.env` and fill in values.
# Never commit `.env` (it may contain real secrets).

NODE_ENV=development
APP_URL=http://localhost:5000

# REQUIRED (server will exit if missing/too short)
# Must be >= 32 chars.
LEGAL_TERMS_HMAC_SECRET=change-me-min-32-chars-change-me

# Recommended for session hardening (dev-safe value is fine)
SESSION_SECRET=change-me

# Optional in dev (warnings only), required in prod
RESEND_API_KEY=
EMAIL_VERIFY_TOKEN_SECRET=
EMAIL_FROM=TradeQuip <noreply@example.com>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Optional quote feed (if blank, repo falls back to simulation paths in places)
FORGE_KEY=
OPENAI_API_KEY=

# Optional Valkey
VALKEY_URL=redis://localhost:6379/0

# Postgres primary database
DB_DIALECT=postgres
DATABASE_URL=postgresql://tradehub:tradehub_pw@localhost:5432/tradehub

# Quote persistence controls (production defaults)
QUOTE_DB_WRITE_MODE=append
QUOTE_DB_WRITE_INTERVAL_MS=5000
DAILY_CLOSE_WRITE_INTERVAL_MS=60000

# Account recalculation throttles
ACCOUNT_RECALC_THROTTLE_MS=250
ACCOUNT_RECALC_BATCH_INTERVAL_MS=250

# Image build note (local-only). Update when pushing to a registry.
IMAGE_REGISTRY=local
IMAGE_TAG=dev
