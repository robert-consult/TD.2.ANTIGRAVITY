{
  "providerKey": "example_provider",
  "displayName": "Example Provider (Generic REST v1)",
  "driver": "generic_rest_v1",
  "config": {
    "driver": "generic_rest_v1",
    "restBaseUrl": "https://api.example.com",
    "quotePath": "/quotes?symbols={{symbols}}",
    "apiKey": "env:MY_PROVIDER_API_KEY",
    "apiKeyParamName": "apikey",
    "symbolsParamName": "symbols",
    "symbolsJoinChar": ",",
    "timeoutMs": 8000,
    "maxBatchSymbols": 50,
    "responseMode": "array",
    "fields": {
      "symbol": "symbol",
      "bid": "bid",
      "ask": "ask",
      "price": "price",
      "timestamp": "timestamp"
    }
  }
}
