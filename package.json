{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "dotenv -e .env -- tsx server/index.ts",
    "build": "vite build && tsx scripts/precompressAssets.ts && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "start:e2e": "dotenv -e .env -- env NODE_ENV=production COOKIE_SECURE=false RESEND_API_KEY=dummy RESEND_FROM=dummy TWILIO_ACCOUNT_SID=dummy TWILIO_AUTH_TOKEN=dummy TWILIO_FROM_NUMBER=+10000000000 node dist/index.js",
    "cap:doctor": "npx cap doctor",
    "cap:sync": "npm run build && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "check": "tsc",
    "e2e:install": "playwright install chromium",
    "e2e:deps": "tsx scripts/playwrightDeps.ts",
    "e2e": "npm run e2e:deps && npm run db:ensure && npm run build && npm run db:seed && playwright test",
    "db:audit": "dotenv -e .env -- tsx scripts/dbAudit.ts",
    "db:audit:auto": "npm run db:schema:dump && npm run db:audit",
    "db:ensure": "dotenv -e .env -- tsx scripts/dbEnsure.ts",
    "db:schema:dump": "dotenv -e .env -- tsx scripts/dbDumpSchema.ts",
    "db:push": "npm run db:ensure",
    "db:seed": "dotenv -e .env -- tsx db/seed.ts",
    "db:bootstrap:drizzle": "dotenv -e .env -- tsx scripts/drizzleBootstrap.ts",
    "db:migrate:drizzle": "dotenv -e .env -- tsx scripts/drizzleMigrate.ts",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "audit:activity": "dotenv -e .env -- tsx scripts/activityAuditVerify.ts",
    "smoke:admin": "dotenv -e .env -- tsx scripts/adminSmoke.ts",
    "db:backup": "dotenv -e .env -- bash scripts/db-backup.sh",
    "db:import:sqlite": "dotenv -e .env -- tsx scripts/sqliteToPostgres.ts",
    "i18n:import:sqlite": "dotenv -e .env -- tsx scripts/i18nSqliteToPostgres.ts",
    "i18n:repair": "dotenv -e .env -- tsx scripts/i18nRepairLocale.ts",
    "i18n:run": "dotenv -e .env -- tsx scripts/i18nRunWorker.ts",
    "loadtest:publish-quotes": "dotenv -e .env -- tsx scripts/loadtest/publishQuotes.ts",
    "loadtest:ws-fanout": "tsx scripts/loadtest/wsFanout.ts"
  },
