# TradeQuip / TradeHub — Environment Template
#
# Copy this file to `.env` and fill in values.
# Never commit `.env` (it may contain real secrets).

NODE_ENV=development
APP_URL=http://localhost:5000
# Optional frontend/browser overrides. Leave unset for same-origin local dev.
VITE_APP_URL=
VITE_API_URL=
VITE_WS_URL=
# Optional Capacitor wrapper override for remote-URL mode.
CAPACITOR_SERVER_URL=
COOKIE_SECURE=
COOKIE_SAMESITE=strict
TRANSPORT_REQUIRE_TLS=
SESSION_STORE=

# REQUIRED (server will exit if missing/too short)
# Must be >= 32 chars.
LEGAL_TERMS_HMAC_SECRET=change-me-min-32-chars-change-me

# Recommended for session hardening (dev-safe value is fine)
SESSION_SECRET=change-me

# Optional in dev (warnings only), required in prod
ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_VERIFY_TOKEN_SECRET=
EMAIL_FROM=TradeQuip <noreply@example.com>
SMS_OTP_SECRET=
CHALLENGE_CERT_VERIFICATION_SECRET=
EXPORT_LOCAL_LINK_SIGNING_SECRET=
METRICS_REQUIRE_PRIVATE=true
METRICS_AUTH_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Market-data providers
TWELVE_DATA_API_KEY=
# Optional legacy provider compatibility only
FORGE_KEY=
OPENAI_API_KEY=
MARKET_DATA_PROVIDER_FILE_SYNC=
MARKET_DATA_PROVIDER_CONFIG_DIR=config/marketdata/providers
MARKET_DATA_PROVIDER_ALLOW_ENV_FALLBACK=

# Optional Valkey
VALKEY_URL=redis://localhost:6379/0

# Postgres primary database
DB_DIALECT=postgres
DATABASE_URL=postgresql://tradehub:tradehub_pw@localhost:5432/tradehub

# Quote persistence controls (production defaults)
QUOTE_DB_WRITE_MODE=append
QUOTE_DB_WRITE_INTERVAL_MS=5000
DAILY_CLOSE_WRITE_INTERVAL_MS=60000

# Account recalculation throttles
ACCOUNT_RECALC_THROTTLE_MS=250
ACCOUNT_RECALC_BATCH_INTERVAL_MS=250

# Petascale / export / analytics
CLICKHOUSE_ENABLED=
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=tradehub
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SYNC_ENABLED=
EXPORT_OBJECT_STORAGE_ENABLED=
EXPORT_OBJECT_STORAGE_ENDPOINT=
EXPORT_OBJECT_STORAGE_PORT=9000
EXPORT_OBJECT_STORAGE_USE_SSL=
EXPORT_OBJECT_STORAGE_BUCKET=admin-data-exports
EXPORT_OBJECT_STORAGE_PREFIX=admin-data
EXPORT_OBJECT_STORAGE_ACCESS_KEY=
EXPORT_OBJECT_STORAGE_SECRET_KEY=
EXPORT_OBJECT_STORAGE_REGION=us-east-1
ALLOW_INSECURE_INTERNAL_TRANSPORT=

# Image build note (local-only). Update when pushing to a registry.
IMAGE_REGISTRY=local
IMAGE_TAG=dev
