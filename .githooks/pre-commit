#!/usr/bin/env bash
set -euo pipefail

changed_files="$(git diff --cached --name-only)"
if [ -z "$changed_files" ]; then
  exit 0
fi

if echo "$changed_files" | grep -E -q '^(db/|shared/schema(\.pg|\.sqlite)?\.ts|shared/schema\.ts|drizzle\.config\.ts|trading_app\.db)'; then
  echo "[hook] DB-related changes detected. Running db audit..."
  npm run db:audit:auto

  if ! git diff --quiet -- db/schema.sql; then
    echo "[hook] db/schema.sql changed. Please stage the updated file and re-commit."
    exit 1
  fi
else
  echo "[hook] No DB-related changes detected. Skipping db audit."
fi
