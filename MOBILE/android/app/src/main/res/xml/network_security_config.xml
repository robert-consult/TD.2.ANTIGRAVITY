<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Network Security Configuration
  Enables secure communication with the canonical TradeQuip backend.
-->
<network-security-config>
    <!-- Production configuration: only allow HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Development/Debug: Allow cleartext for local testing -->
    <debug-overrides cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- 
      Domain-specific configuration for production/staging backends.
      Add SSL pinning for production security
    -->
    <domain-config>
        <domain includeSubdomains="true">tradehub.example.com</domain>
        <domain includeSubdomains="true">staging.tradehub.example.com</domain>
        
        <!-- Trust only system CAs for these domains -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        
        <!--
          SSL Pinning (uncomment and add your certificate hashes for production)
          Generate hash with: openssl s_client -connect tradehub.example.com:443 | openssl x509 -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl enc -base64
        -->
        <!--
        <pin-set expiration="2027-01-01">
            <pin digest="SHA-256">YOUR_CERTIFICATE_HASH_HERE</pin>
            <pin digest="SHA-256">YOUR_BACKUP_CERTIFICATE_HASH_HERE</pin>
        </pin-set>
        -->
    </domain-config>

    <!-- Allow local development server (Android emulator) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
